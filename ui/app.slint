import { Theme, ThemePreference } from "theme.slint";
import { DiskInfo } from "types.slint";
import { TabsBar } from "sections/tabs-bar.slint";
import { Ribbon } from "sections/ribbon.slint";
import { AddressBar } from "sections/address-bar.slint";
import { NavPane } from "sections/nav-pane.slint";
import { ContentPane } from "sections/content-pane.slint";
import { StatusBar } from "sections/status-bar.slint";
import { ThinSeparator } from "components/thin-separator.slint";
import { SettingsPage } from "sections/settings-page.slint";

export { DiskInfo, Theme, ThemePreference }

export component AppWindow inherits Window {
    title: "Folder Lab";
    icon: @image-url("icons/explorer.svg");
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 700px;
    min-height: 420px;
    background: Theme.bg;
    default-font-family: "Noto Sans";
    default-font-size: 12px;

    in property <[DiskInfo]> disks;

    // "main" or "settings"
    in-out property <bool> show-settings: false;

    callback theme-selected(ThemePreference);

    if !root.show-settings : VerticalLayout {
        TabsBar {
            settings-requested => { root.show-settings = true; }
        }
        Ribbon { }
        ThinSeparator { }
        AddressBar { }
        ThinSeparator { }

        HorizontalLayout {
            vertical-stretch: 1;

            NavPane { }

            Rectangle {
                width: 1px;
                background: Theme.separator;
            }

            ContentPane {
                disks: root.disks;
            }
        }

        ThinSeparator { }
        StatusBar {
            item-count: root.disks.length;
        }
    }

    if root.show-settings : SettingsPage {
        go-back => { root.show-settings = false; }
        theme-selected(pref) => { root.theme-selected(pref); }
    }
}
