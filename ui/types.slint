export struct DiskInfo {
    title: string,
    device: string,
    mount: string,
    fs: string,
    total: string,
    free: string,
    used: float,
}

export struct FileEntry {
    name: string,
    is-dir: bool,
    size: string,
    size-bytes: int,
    date-modified: string,
    date-timestamp: int,
    file-type: string,
    is-hidden: bool,
}

export struct FileDetails {
    name: string,
    is-dir: bool,
    is-disk: bool,
    file-type: string,
    location: string,
    date-modified: string,
    size: string,
    folders-count: string,
    files-count: string,
    free-space: string,
    total-space: string,
    used-space: string,
    fs-type: string,
    device: string,
    disk-used-percent: float,
    has-selection: bool,
}

// What the content pane should display
export enum BrowseState {
    Home,
    Directory,
    NoPermission,
    Empty,
}

export enum ViewMode {
    Grid,
    Details,
}

export enum SortField {
    Name,
    Date,
    Type,
    Size,
}

export enum SortOrder {
    Ascending,
    Descending,
}
