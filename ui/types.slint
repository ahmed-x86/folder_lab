export struct DiskInfo {
    title: string,
    device: string,
    mount: string,
    fs: string,
    total: string,
    free: string,
    used: float,
    icon: image,
}

export struct FileEntry {
    name: string,
    is-dir: bool,
    size: string,
    size-bytes: int,
    date-modified: string,
    date-timestamp: int,
    file-type: string,
    is-hidden: bool,
    icon: image,
}

export struct FileDetails {
    name: string,
    is-dir: bool,
    is-disk: bool,
    file-type: string,
    location: string,
    date-modified: string,
    size: string,
    folders-count: string,
    files-count: string,
    free-space: string,
    total-space: string,
    used-space: string,
    fs-type: string,
    device: string,
    disk-used-percent: float,
    has-selection: bool,
    icon: image,
}

// What the content pane should display
export enum BrowseState {
    Home,
    Directory,
    NoPermission,
    Empty,
}

// Matches the classic Windows Explorer "View" menu, ordered from the
// largest grid icons down to the most compact list, so that the enum's
// declaration order doubles as the zoom order used by Ctrl+Wheel and the
// Ctrl+Plus/Minus style stepping.
export enum ViewMode {
    ExtraLargeIcons,
    LargeIcons,
    MediumIcons,
    SmallIcons,
    List,
    Details,
    Tiles,
    Content,
}

export enum SortField {
    Name,
    Date,
    Type,
    Size,
}

export enum SortOrder {
    Ascending,
    Descending,
}
