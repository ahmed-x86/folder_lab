import { Theme, ThemePreference } from "theme.slint";
import { RadioOption } from "components/radio-option.slint";

export component SettingsWindow inherits Window {
    title: "Settings";
    icon: @image-url("icons/explorer.svg");
    preferred-width: 520px;
    preferred-height: 150px;
    min-width: 460px;
    min-height: 110px;
    background: Theme.bg;
    default-font-family: "Noto Sans";
    default-font-size: 12px;

    // The main window listens to this to apply the same preference.
    callback theme-selected(ThemePreference);

    VerticalLayout {
        padding: 24px;
        alignment: start;

        HorizontalLayout {
            height: 28px;
            spacing: 12px;

            Text {
                text: "Theme";
                width: 80px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }

            RadioOption {
                horizontal-stretch: 1;
                label: "Light";
                checked: Theme.preference == ThemePreference.light;
                clicked => {
                    Theme.preference = ThemePreference.light;
                    root.theme-selected(ThemePreference.light);
                }
            }

            RadioOption {
                horizontal-stretch: 1;
                label: "Dark";
                checked: Theme.preference == ThemePreference.dark;
                clicked => {
                    Theme.preference = ThemePreference.dark;
                    root.theme-selected(ThemePreference.dark);
                }
            }

            RadioOption {
                horizontal-stretch: 1;
                label: "Follow system";
                checked: Theme.preference == ThemePreference.system;
                clicked => {
                    Theme.preference = ThemePreference.system;
                    root.theme-selected(ThemePreference.system);
                }
            }
        }
    }
}
