import { Theme } from "../theme.slint";
import { Glyph } from "glyph.slint";

export component SidebarItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> expandable: false;

    height: 30px;
    background: root.selected ? Theme.selected : (touch.has-hover ? Theme.hover-soft : transparent);

    if root.selected : Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: 100%;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;

        Glyph {
            source: root.icon;
            icon-size: 16px;
        }

        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.expandable : Glyph {
            source: @image-url("../icons/chevron-right.svg");
            tint: Theme.mono-tint;
            icon-size: 10px;
            faded: 0.45;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
    }
}
