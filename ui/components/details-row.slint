import { Theme } from "../theme.slint";
import { FileEntry, ViewMode } from "../types.slint";

// صف واحد في أوضاع العرض الشبيهة بالقوائم: List (اسم فقط)، Details (كل
// الأعمدة)، وContent (أيقونة أكبر مع سطرين من المعلومات). الشكل يتغيّر
// حسب `mode` بدل أن يكون لكل وضع مكوّن منفصل، لأن المنطق المشترك (التحديد،
// hover، النقر المزدوج) واحد تمامًا بين الثلاثة.
export component DetailsRow inherits Rectangle {
    in property <FileEntry> entry;
    in property <bool> selected: false;
    in property <ViewMode> mode: ViewMode.Details;
    in property <length> row-height: 28px;
    callback clicked();
    callback double-clicked();

    height: root.row-height;
    border-radius: 3px;
    background: root.selected
        ? Theme.selected
        : (touch.has-hover ? Theme.card-hover : transparent);
    border-width: 1px;
    border-color: root.selected ? Theme.accent.with-alpha(0.5) : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: start;

        // Name with icon (present in every mode)
        HorizontalLayout {
            horizontal-stretch: root.mode == ViewMode.List ? 1 : 0;
            width: root.mode == ViewMode.List ? root.width : (root.mode == ViewMode.Content ? 320px : 260px);
            spacing: root.mode == ViewMode.Content ? 10px : 8px;
            alignment: start;

            Image {
                source: root.entry.icon.width > 0
                    ? root.entry.icon
                    : (root.entry.is-dir
                        ? @image-url("../icons/folder.svg")
                        : @image-url("../icons/file.svg"));
                width: root.mode == ViewMode.Content ? 40px : 16px;
                height: root.mode == ViewMode.Content ? 40px : 16px;
                image-fit: ImageFit.contain;
                vertical-alignment: center;
            }

            if root.mode != ViewMode.Content : Text {
                text: root.entry.name;
                font-size: 11px;
                color: Theme.text;
                vertical-alignment: center;
                overflow: TextOverflow.elide;
                horizontal-stretch: 1;
            }

            // Content view: name on top, secondary info line below (like
            // Explorer's "Content" view).
            if root.mode == ViewMode.Content : VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.entry.name;
                    font-size: 12px;
                    color: Theme.text;
                    overflow: TextOverflow.elide;
                }

                Text {
                    text: root.entry.is-dir
                        ? "\{root.entry.file-type} · \{root.entry.date-modified}"
                        : "\{root.entry.file-type} · \{root.entry.size} · \{root.entry.date-modified}";
                    font-size: 10px;
                    color: Theme.text-secondary;
                    overflow: TextOverflow.elide;
                }
            }
        }

        // Date modified (Details only)
        if root.mode == ViewMode.Details : Text {
            width: 140px;
            text: root.entry.date-modified;
            font-size: 11px;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: TextOverflow.elide;
        }

        // Type (Details only)
        if root.mode == ViewMode.Details : Text {
            width: 140px;
            text: root.entry.file-type;
            font-size: 11px;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: TextOverflow.elide;
        }

        // Size (Details only)
        if root.mode == ViewMode.Details : Text {
            width: 80px;
            text: root.entry.size;
            font-size: 11px;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: TextOverflow.elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
}
