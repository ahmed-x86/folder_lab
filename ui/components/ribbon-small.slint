import { Theme } from "../theme.slint";
import { Glyph } from "glyph.slint";

export component RibbonSmall inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <length> item-width: 78px;

    width: root.item-width;
    height: 20px;
    border-radius: 2px;
    background: touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 5px;

        Glyph {
            source: root.icon;
            icon-size: 14px;
        }

        Text {
            text: root.label;
            font-size: 11px;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
    }
}
