import { Theme } from "../theme.slint";
import { Glyph } from "glyph.slint";
import { UsageBar } from "usage-bar.slint";
import { DiskInfo } from "../types.slint";

export component DriveCard inherits Rectangle {
    in property <DiskInfo> disk;
    in property <bool> selected: false;
    callback clicked();
    callback double-clicked();

    width: 250px;
    height: 80px;
    border-radius: 3px;
    background: root.selected ? Theme.selected : (touch.has-hover ? Theme.card-hover : transparent);
    border-width: 1px;
    border-color: root.selected ? Theme.accent.with-alpha(0.6) : (touch.has-hover ? Theme.hover-border : transparent);

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;

        Image {
            source: root.disk.icon.width > 0
                ? root.disk.icon
                : @image-url("../icons/drive.svg");
            width: 48px;
            height: 48px;
            image-fit: ImageFit.contain;
        }

        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 1;

            Text {
                text: root.disk.title;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }

            UsageBar {
                used: root.disk.used;
            }

            Text {
                text: root.disk.free;
                font-size: 11px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}
