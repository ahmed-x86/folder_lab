import { Theme } from "../theme.slint";

export component MenuItem inherits Rectangle {
    in property <string> label;
    callback clicked();

    height: 28px;
    background: touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;

        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}
