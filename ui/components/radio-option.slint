import { Theme } from "../theme.slint";

export component RadioOption inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    callback clicked();

    height: 28px;

    HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            min-width: 16px;
            preferred-width: 16px;
            max-width: 16px;

            Rectangle {
                height: 16px;
                border-radius: 8px;
                border-width: 2px;
                border-color: root.checked ? Theme.accent : Theme.text-muted;

                if root.checked : Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                }
            }
        }

        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}
