import { Theme } from "../theme.slint";
export component RibbonBig inherits Rectangle {
    in property <image> icon;
    in property <string> label;

    width: 56px;
    height: 60px;
    border-radius: 3px;
    background: touch.has-hover ? Theme.hover : transparent;
    border-width: touch.has-hover ? 1px : 0px;
    border-color: Theme.hover-border;

    VerticalLayout {
        alignment: center;
        spacing: 3px;

        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 24px;
                height: 24px;
                image-fit: ImageFit.contain;
            }
        }

        Text {
            text: root.label;
            font-size: 10px;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
    }
}
