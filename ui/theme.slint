import { Palette } from "std-widgets.slint";

export enum ThemePreference { system, light, dark, latte, frappe, macchiato, mocha, whiteDark, blackLight, blueAccent, butterCream, mintCream, oliveGrove, violetGrid, violetNight, android13, nord, dracula, gruvbox, tokyoNight, rose, amoledBlack, oceanTeal, sunset, forest, sakura, custom }

// All presets from the colour picker, plus a fully editable custom palette.
export global Theme {
    in-out property <ThemePreference> preference: ThemePreference.system;

    // Hex text typed by the user (bound to the input fields).
    in-out property <string> custom-bg-hex: "#1e1e2e";
    in-out property <string> custom-sidebar-hex: "#181825";
    in-out property <string> custom-ribbon-hex: "#11111b";
    in-out property <string> custom-field-hex: "#313244";
    in-out property <string> custom-accent-hex: "#cba6f7";
    in-out property <string> custom-text-hex: "#cdd6f4";
    in-out property <string> custom-text-secondary-hex: "#bac2de";
    in-out property <string> custom-border-hex: "#585b70";
    in-out property <string> custom-icon-tint-hex: "#cdd6f4";

    // Parsed colours, kept in sync with the hex text by the app.
    in-out property <color> custom-bg: #1e1e2e;
    in-out property <color> custom-sidebar: #181825;
    in-out property <color> custom-ribbon: #11111b;
    in-out property <color> custom-field: #313244;
