    in-out property <color> custom-border: #585b70;
    in-out property <color> custom-icon-tint: #cdd6f4;

    property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    property <int> idx: Theme.preset-index(root.preference);

