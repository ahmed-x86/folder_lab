        ThemePreference.sunset,
        ThemePreference.forest,
        ThemePreference.sakura,
        ThemePreference.custom
    ];

    public pure function preset-index(p: ThemePreference) -> int {
        if (p == ThemePreference.system) { return 0; }
        if (p == ThemePreference.light) { return 1; }
        if (p == ThemePreference.dark) { return 2; }
        if (p == ThemePreference.latte) { return 3; }
        if (p == ThemePreference.frappe) { return 4; }
        if (p == ThemePreference.macchiato) { return 5; }
        if (p == ThemePreference.mocha) { return 6; }
        if (p == ThemePreference.whiteDark) { return 7; }
        if (p == ThemePreference.blackLight) { return 8; }
        if (p == ThemePreference.blueAccent) { return 9; }
        if (p == ThemePreference.butterCream) { return 10; }
        if (p == ThemePreference.mintCream) { return 11; }
        if (p == ThemePreference.oliveGrove) { return 12; }
        if (p == ThemePreference.violetGrid) { return 13; }
        if (p == ThemePreference.violetNight) { return 14; }
        if (p == ThemePreference.android13) { return 15; }
        if (p == ThemePreference.nord) { return 16; }
        if (p == ThemePreference.dracula) { return 17; }
        if (p == ThemePreference.gruvbox) { return 18; }
        if (p == ThemePreference.tokyoNight) { return 19; }
        if (p == ThemePreference.rose) { return 20; }
        if (p == ThemePreference.amoledBlack) { return 21; }
        if (p == ThemePreference.oceanTeal) { return 22; }
        if (p == ThemePreference.sunset) { return 23; }
        if (p == ThemePreference.forest) { return 24; }
        if (p == ThemePreference.sakura) { return 25; }
        if (p == ThemePreference.custom) { return 26; }
        return 26;
    }
    public pure function dot1(p: ThemePreference) -> color { return p-dot1[preset-index(p)]; }
    public pure function dot2(p: ThemePreference) -> color { return p-dot2[preset-index(p)]; }
    public pure function dot3(p: ThemePreference) -> color { return p-dot3[preset-index(p)]; }
    public pure function dot4(p: ThemePreference) -> color { return p-dot4[preset-index(p)]; }
    public pure function preset-label(p: ThemePreference) -> string { return p-label[preset-index(p)]; }
    public pure function preset-bg(p: ThemePreference) -> color { return p-bg[preset-index(p)]; }
    public pure function preset-text(p: ThemePreference) -> color { return p-text[preset-index(p)]; }
    public pure function preset-border(p: ThemePreference) -> color { return p-border[preset-index(p)]; }
    public pure function preset-accent(p: ThemePreference) -> color { return p-accent[preset-index(p)]; }
    public pure function preset-field(p: ThemePreference) -> color { return p-field[preset-index(p)]; }

    out property <bool> dark: root.preference == ThemePreference.system
        ? root.system-dark : p-dark[root.idx];
    out property <bool> is-catppuccin: root.preference == ThemePreference.latte
        || root.preference == ThemePreference.frappe
        || root.preference == ThemePreference.macchiato
        || root.preference == ThemePreference.mocha;

    out property <brush> tabs-bg: root.preference == ThemePreference.system
        ? (root.system-dark ? #2b2b2b : #f2f2f2)
        : (root.idx == 26 ? root.custom-sidebar : p-tabs[root.idx]);
    out property <brush> status-bg: root.preference == ThemePreference.system
        ? (root.system-dark ? #2b2b2b : #f2f2f2)
        : (root.idx == 26 ? root.custom-sidebar : p-tabs[root.idx]);
    out property <brush> ribbon-bg: root.preference == ThemePreference.system
        ? (root.system-dark ? #262626 : #fbfbfb)
        : (root.idx == 26 ? root.custom-ribbon : p-ribbon[root.idx]);
    out property <brush> sidebar-bg: root.preference == ThemePreference.system
        ? (root.system-dark ? #232323 : #f7f8fa)
        : (root.idx == 26 ? root.custom-sidebar : p-sidebar[root.idx]);
    out property <brush> field-bg: root.preference == ThemePreference.system
        ? (root.system-dark ? #2a2a2a : #ffffff)
        : (root.idx == 26 ? root.custom-field : p-field[root.idx]);
    out property <brush> menu-bg: root.preference == ThemePreference.system
        ? (root.system-dark ? #1f1f1f : #ffffff)
        : (root.idx == 26 ? root.custom-bg : p-bg[root.idx]);
    out property <brush> separator: root.preference == ThemePreference.system
        ? (root.system-dark ? #4a4a4a : #d6d6d6)
        : (root.idx == 26 ? root.custom-border : p-border[root.idx]);
    out property <brush> field-border: root.preference == ThemePreference.system
        ? (root.system-dark ? #4a4a4a : #d6d6d6)
        : (root.idx == 26 ? root.custom-border : p-border[root.idx]);
    out property <brush> text: root.preference == ThemePreference.system
        ? (root.system-dark ? #e6e6e6 : #1f1f1f)
        : (root.idx == 26 ? root.custom-text : p-text[root.idx]);
    out property <brush> text-secondary: root.preference == ThemePreference.system
        ? (root.system-dark ? #b5b5b5 : #4a4a4a)
        : (root.idx == 26 ? root.custom-text-secondary : p-text2[root.idx]);
    out property <brush> text-muted: root.preference == ThemePreference.system
        ? (root.system-dark ? #b5b5b5 : #4a4a4a)
        : (root.idx == 26 ? root.custom-text-secondary : p-text2[root.idx]);
    out property <brush> hover: root.preference == ThemePreference.system
        ? (root.system-dark ? #2a2a2a : #ffffff)
        : (root.idx == 26 ? root.custom-field : p-field[root.idx]);
    out property <brush> hover-soft: root.preference == ThemePreference.system
        ? (root.system-dark ? #2a2a2a : #ffffff)
        : (root.idx == 26 ? root.custom-field : p-field[root.idx]);
    out property <brush> card-hover: root.preference == ThemePreference.system
        ? (root.system-dark ? #2a2a2a : #ffffff)
        : (root.idx == 26 ? root.custom-field : p-field[root.idx]);
    out property <brush> hover-border: root.preference == ThemePreference.system
        ? (root.system-dark ? #3b9eef : #0078d7)
        : (root.idx == 26 ? root.custom-accent : p-accent[root.idx]);
    out property <brush> selected: root.preference == ThemePreference.system
        ? (root.system-dark ? #2a2a2a : #ffffff)
        : (root.idx == 26 ? root.custom-field : p-field[root.idx]);
    out property <brush> accent: root.preference == ThemePreference.system
        ? (root.system-dark ? #3b9eef : #0078d7)
        : (root.idx == 26 ? root.custom-accent : p-accent[root.idx]);
    out property <brush> bar-track: root.preference == ThemePreference.system
        ? (root.system-dark ? #4a4a4a : #d6d6d6)
        : (root.idx == 26 ? root.custom-border : p-border[root.idx]);
    out property <brush> bar-border: root.preference == ThemePreference.system
        ? (root.system-dark ? #4a4a4a : #d6d6d6)
        : (root.idx == 26 ? root.custom-border : p-border[root.idx]);
    out property <brush> bar-fill: root.preference == ThemePreference.system
        ? (root.system-dark ? #3b9eef : #0078d7)
        : (root.idx == 26 ? root.custom-accent : p-accent[root.idx]);
    out property <brush> bar-full: root.preference == ThemePreference.system
        ? (root.system-dark ? #3b9eef : #0078d7)
        : (root.idx == 26 ? root.custom-accent : p-accent[root.idx]);
    out property <brush> mono-tint: root.preference == ThemePreference.system
        ? (root.system-dark ? #d0d0d0 : #00000000)
        : (root.idx == 26 ? root.custom-icon-tint : p-mono[root.idx]);
    out property <brush> bg: root.preference == ThemePreference.system
        ? (root.system-dark ? #1f1f1f : #ffffff)
        : (root.idx == 26 ? root.custom-bg : p-bg[root.idx]);
}
