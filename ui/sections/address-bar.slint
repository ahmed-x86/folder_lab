import { Theme } from "../theme.slint";
import { Glyph } from "../components/glyph.slint";
import { IconButton } from "../components/icon-button.slint";

export component AddressBar inherits Rectangle {
    height: 36px;
    background: Theme.bg;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 2px;

        IconButton {
            icon: @image-url("../icons/arrow-left.svg");
        }

        IconButton {
            icon: @image-url("../icons/arrow-right.svg");
            enabled: false;
        }

        IconButton {
            icon: @image-url("../icons/arrow-up.svg");
        }

        IconButton {
            icon: @image-url("../icons/refresh.svg");
            enabled: false;
        }

        Rectangle {
            width: 6px;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 26px;
            border-width: 1px;
            border-color: Theme.field-border;
            border-radius: 2px;
            background: Theme.field-bg;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 6px;

                Glyph {
                    source: @image-url("../icons/pc.svg");
                    icon-size: 16px;
                }

                Text {
                    text: "Folder Lab";
                    font-size: 12px;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Glyph {
                    source: @image-url("../icons/chevron-down.svg");
                    tint: Theme.mono-tint;
                    icon-size: 10px;
                    faded: 0.5;
                }
            }
        }

        Rectangle {
            width: 8px;
        }

        Rectangle {
            width: 196px;
            height: 26px;
            border-width: 1px;
            border-color: Theme.field-border;
            border-radius: 2px;
            background: Theme.field-bg;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 6px;

                Glyph {
                    source: @image-url("../icons/search.svg");
                    tint: Theme.mono-tint;
                    icon-size: 14px;
                }

                Text {
                    text: "Search Folder Lab";
                    font-size: 11px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }
    }
}
