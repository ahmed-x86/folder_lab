import { MenuItem } from "../components/menu-item.slint";
import { Theme } from "../theme.slint";
export component TabsBar inherits Rectangle {
    callback settings-requested();

    height: 30px;
    background: Theme.tabs-bg;

    HorizontalLayout {
        Rectangle {
            width: 48px;
            background: file-touch.has-hover ? #3a68ad : #2b579a;

            Text {
                text: "File";
                width: 100%;
                height: 100%;
                font-size: 11px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            file-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { file-menu.show(); }
            }

            file-menu := PopupWindow {
                x: 0;
                y: parent.height;
                width: 170px;
                height: 34px;

                Rectangle {
                    background: Theme.menu-bg;
                    border-width: 1px;
                    border-color: Theme.field-border;

                    VerticalLayout {
                        padding: 2px;

                        MenuItem {
                            label: "Settings";
                            clicked => { root.settings-requested(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 64px;
            background: Theme.bg;

            Text {
                text: "Home";
                width: 100%;
                height: 100%;
                font-size: 11px;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                y: parent.height - 2px;
                width: 100%;
                height: 2px;
                background: Theme.accent;
            }
        }

        Rectangle {
            width: 60px;

            Text {
                text: "Share";
                width: 100%;
                height: 100%;
                font-size: 11px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 56px;

            Text {
                text: "View";
                width: 100%;
                height: 100%;
                font-size: 11px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle { }
    }
}
