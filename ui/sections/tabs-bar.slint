export component TabsBar inherits Rectangle {
    height: 30px;
    background: #f2f2f2;

    HorizontalLayout {
        Rectangle {
            width: 48px;
            background: #2b579a;

            Text {
                text: "File";
                width: 100%;
                height: 100%;
                font-size: 11px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 64px;
            background: #ffffff;

            Text {
                text: "Home";
                width: 100%;
                height: 100%;
                font-size: 11px;
                color: #1f1f1f;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                y: parent.height - 2px;
                width: 100%;
                height: 2px;
                background: #0078d7;
            }
        }

        Rectangle {
            width: 60px;

            Text {
                text: "Share";
                width: 100%;
                height: 100%;
                font-size: 11px;
                color: #4a4a4a;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 56px;

            Text {
                text: "View";
                width: 100%;
                height: 100%;
                font-size: 11px;
                color: #4a4a4a;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle { }
    }
}
