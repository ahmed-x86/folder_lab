import { Theme } from "../theme.slint";
import { Glyph } from "../components/glyph.slint";

export component StatusBar inherits Rectangle {
    in property <int> item-count;

    height: 24px;
    background: Theme.status-bg;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;

        Text {
            text: "\{root.item-count} items";
            font-size: 11px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Glyph {
            source: @image-url("../icons/view-details.svg");
            tint: Theme.mono-tint;
            icon-size: 14px;
            faded: 0.75;
        }

        Glyph {
            source: @image-url("../icons/view-grid.svg");
            tint: Theme.mono-tint;
            icon-size: 14px;
            faded: 0.75;
        }
    }
}
