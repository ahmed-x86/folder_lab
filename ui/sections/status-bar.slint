import { Theme } from "../theme.slint";
import { Glyph } from "../components/glyph.slint";
import { ViewMode } from "../types.slint";

export component StatusBar inherits Rectangle {
    in property <int> item-count: 0;
    in property <int> selected-count: 0;
    in-out property <ViewMode> view-mode: ViewMode.MediumIcons;
    callback view-mode-changed(ViewMode);

    height: 24px;
    background: Theme.status-bg;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;

        // Items count
        Text {
            text: root.selected-count > 0
                ? "\{root.item-count} items | \{root.selected-count} item selected |"
                : "\{root.item-count} items |";
            font-size: 11px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        // Details view toggle button
        btn-details := Rectangle {
            width: 22px;
            height: 20px;
            border-radius: 3px;
            background: root.view-mode == ViewMode.Details
                ? Theme.selected
                : (touch-details.has-hover ? Theme.hover : transparent);

            Glyph {
                source: @image-url("../icons/view-details.svg");
                tint: root.view-mode == ViewMode.Details ? Theme.accent : Theme.mono-tint;
                icon-size: 14px;
                faded: root.view-mode == ViewMode.Details ? 1.0 : 0.65;
            }

            touch-details := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.view-mode = ViewMode.Details;
                    root.view-mode-changed(ViewMode.Details);
                }
            }
        }

        // Grid view toggle button
        btn-grid := Rectangle {
            width: 22px;
            height: 20px;
            border-radius: 3px;
            background: root.view-mode == ViewMode.MediumIcons
                ? Theme.selected
                : (touch-grid.has-hover ? Theme.hover : transparent);

            Glyph {
                source: @image-url("../icons/view-grid.svg");
                tint: root.view-mode == ViewMode.MediumIcons ? Theme.accent : Theme.mono-tint;
                icon-size: 14px;
                faded: root.view-mode == ViewMode.MediumIcons ? 1.0 : 0.65;
            }

            touch-grid := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.view-mode = ViewMode.MediumIcons;
                    root.view-mode-changed(ViewMode.MediumIcons);
                }
            }
        }
    }
}
