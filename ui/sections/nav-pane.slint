import { Theme } from "../theme.slint";
import { SidebarItem } from "../components/sidebar-item.slint";

export component NavPane inherits Rectangle {
    width: 200px;
    background: Theme.sidebar-bg;

    in property <string> current-path: "";

    callback navigate-to(string);
    callback navigate-special(string);
    callback navigate-home();

    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 0;

        SidebarItem {
            icon: @image-url("../icons/home.svg");
            label: "Home";
            clicked => { root.navigate-special("home"); }
        }

        SidebarItem {
            icon: @image-url("../icons/gallery.svg");
            label: "Gallery";
            clicked => { root.navigate-special("pictures"); }
        }

        Rectangle {
            height: 9px;

            Rectangle {
                y: 4px;
                height: 1px;
                background: Theme.separator;
            }
        }

        SidebarItem {
            icon: @image-url("../icons/folder-desktop.svg");
            label: "Desktop";
            expandable: true;
            clicked => { root.navigate-special("desktop"); }
        }

        SidebarItem {
            icon: @image-url("../icons/folder-downloads.svg");
            label: "Downloads";
            expandable: true;
            clicked => { root.navigate-special("downloads"); }
        }

        SidebarItem {
            icon: @image-url("../icons/folder-documents.svg");
            label: "Documents";
            expandable: true;
            clicked => { root.navigate-special("documents"); }
        }

        SidebarItem {
            icon: @image-url("../icons/folder-pictures.svg");
            label: "Pictures";
            expandable: true;
            clicked => { root.navigate-special("pictures"); }
        }

        SidebarItem {
            icon: @image-url("../icons/folder-music.svg");
            label: "Music";
            expandable: true;
            clicked => { root.navigate-special("music"); }
        }

        SidebarItem {
            icon: @image-url("../icons/folder-videos.svg");
            label: "Videos";
            expandable: true;
            clicked => { root.navigate-special("videos"); }
        }

        Rectangle {
            height: 9px;

            Rectangle {
                y: 4px;
                height: 1px;
                background: Theme.separator;
            }
        }

        SidebarItem {
            icon: @image-url("../icons/pc.svg");
            label: "This PC";
            selected: root.current-path == "";
            clicked => { root.navigate-home(); }
        }

        SidebarItem {
            icon: @image-url("../icons/network.svg");
            label: "Network";
        }

        Rectangle { }
    }
}
