        }


        Rectangle {
            height: 9px;

            Rectangle {
                y: 4px;
                height: 1px;
                background: #e1e4e8;
            }
        }

        SidebarItem {
            icon: @image-url("../icons/folder-desktop.svg");
            label: "Desktop";
            expandable: true;
        }

        SidebarItem {
            icon: @image-url("../icons/folder-downloads.svg");
            label: "Downloads";
            expandable: true;
        }

        SidebarItem {
            icon: @image-url("../icons/folder-documents.svg");
            label: "Documents";
            expandable: true;
        }

        SidebarItem {
            icon: @image-url("../icons/folder-pictures.svg");
            label: "Pictures";
