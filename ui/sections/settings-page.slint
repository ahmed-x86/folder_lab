import { Theme, ThemePreference } from "../theme.slint";
import { RadioOption } from "../components/radio-option.slint";
import { Glyph } from "../components/glyph.slint";

component ThemeCard inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <brush> preview-bg;
    in property <brush> preview-sidebar;
    in property <brush> preview-accent;
    in property <brush> preview-text;
    callback clicked();

    width: 110px;
    height: 90px;
    border-radius: 8px;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? Theme.accent : Theme.field-border;
    background: Theme.field-bg;
    clip: true;

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Mini preview
        Rectangle {
            height: 55px;
            background: root.preview-bg;
            clip: true;

            HorizontalLayout {
                padding: 4px;
                spacing: 2px;

                // Sidebar
                Rectangle {
                    width: 24px;
                    background: root.preview-sidebar;
                    border-radius: 2px;

                    VerticalLayout {
                        padding-top: 4px;
                        spacing: 3px;
                        alignment: start;

                        Rectangle { height: 2px; width: 16px; background: root.preview-text; opacity: 0.3; }
                        Rectangle { height: 2px; width: 14px; background: root.preview-text; opacity: 0.3; }
                        Rectangle { height: 2px; width: 16px; background: root.preview-text; opacity: 0.3; }
                    }
                }

                // Content area
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 4px;
                    spacing: 3px;

                    // Accent bar at top
                    Rectangle { height: 3px; background: root.preview-accent; border-radius: 1px; }
                    Rectangle { height: 2px; width: 60%; background: root.preview-text; opacity: 0.25; }
                    Rectangle { height: 2px; width: 45%; background: root.preview-text; opacity: 0.25; }
                    Rectangle { height: 2px; width: 55%; background: root.preview-text; opacity: 0.25; }
                }
            }
        }

        // Label
        Rectangle {
            height: 35px;

            HorizontalLayout {
                padding-left: 8px;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    min-width: 14px;
                    preferred-width: 14px;
                    max-width: 14px;

                    Rectangle {
                        height: 14px;
                        border-radius: 7px;
                        border-width: 2px;
                        border-color: root.checked ? Theme.accent : Theme.text-muted;

                        if root.checked : Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: Theme.accent;
                        }
                    }
                }

                Text {
                    text: root.label;
                    font-size: 11px;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsPage inherits Rectangle {
    background: Theme.bg;

    callback theme-selected(ThemePreference);
    callback go-back();

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Header bar with back button
        Rectangle {
            height: 40px;
            background: Theme.sidebar-bg;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: 4px;
                    border-radius: 4px;
                    background: back-touch.has-hover ? Theme.hover : transparent;

                    Glyph {
                        source: @image-url("../icons/arrow-left.svg");
                        tint: Theme.mono-tint;
                        icon-size: 16px;
                    }

                    back-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.go-back(); }
                    }
                }

                Text {
                    text: "Settings";
                    font-size: 16px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                Rectangle { }
            }
        }

        // Separator
        Rectangle {
            height: 1px;
            background: Theme.separator;
        }

        // Settings content
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                spacing: 24px;

                // ── Standard themes ──
                VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: "Theme";
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                    }

                    HorizontalLayout {
                        height: 28px;
                        spacing: 12px;

                        RadioOption {
                            horizontal-stretch: 1;
                            label: "Light";
                            checked: Theme.preference == ThemePreference.light;
                            clicked => {
                                Theme.preference = ThemePreference.light;
                                root.theme-selected(ThemePreference.light);
                            }
                        }

                        RadioOption {
                            horizontal-stretch: 1;
                            label: "Dark";
                            checked: Theme.preference == ThemePreference.dark;
                            clicked => {
                                Theme.preference = ThemePreference.dark;
                                root.theme-selected(ThemePreference.dark);
                            }
                        }

                        RadioOption {
                            horizontal-stretch: 1;
                            label: "Follow system";
                            checked: Theme.preference == ThemePreference.system;
                            clicked => {
                                Theme.preference = ThemePreference.system;
                                root.theme-selected(ThemePreference.system);
                            }
                        }
                    }
                }

                // ── Catppuccin themes ──
                VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: "Catppuccin";
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        ThemeCard {
                            label: "Latte";
                            checked: Theme.preference == ThemePreference.latte;
                            preview-bg: #eff1f5;
                            preview-sidebar: #e6e9ef;
                            preview-accent: #8839ef;
                            preview-text: #4c4f69;
                            clicked => {
                                Theme.preference = ThemePreference.latte;
                                root.theme-selected(ThemePreference.latte);
                            }
                        }

                        ThemeCard {
                            label: "Frappé";
                            checked: Theme.preference == ThemePreference.frappe;
                            preview-bg: #303446;
                            preview-sidebar: #292c3c;
                            preview-accent: #ca9ee6;
                            preview-text: #c6d0f5;
                            clicked => {
                                Theme.preference = ThemePreference.frappe;
                                root.theme-selected(ThemePreference.frappe);
                            }
                        }

                        ThemeCard {
                            label: "Macchiato";
                            checked: Theme.preference == ThemePreference.macchiato;
                            preview-bg: #24273a;
                            preview-sidebar: #1e2030;
                            preview-accent: #c6a0f6;
                            preview-text: #cad3f5;
                            clicked => {
                                Theme.preference = ThemePreference.macchiato;
                                root.theme-selected(ThemePreference.macchiato);
                            }
                        }

                        ThemeCard {
                            label: "Mocha";
                            checked: Theme.preference == ThemePreference.mocha;
                            preview-bg: #1e1e2e;
                            preview-sidebar: #181825;
                            preview-accent: #cba6f7;
                            preview-text: #cdd6f4;
                            clicked => {
                                Theme.preference = ThemePreference.mocha;
                                root.theme-selected(ThemePreference.mocha);
                            }
                        }

                        Rectangle { }
                    }
                }

                Rectangle { }
            }
        }
    }
}
