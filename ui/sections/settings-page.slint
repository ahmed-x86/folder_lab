import { Theme, ThemePreference } from "../theme.slint";
import { Glyph } from "../components/glyph.slint";

// Preset card inspired by modern theme pickers (Title + 4 palette color dots)
component ThemePresetCard inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <color> dot1;
    in property <color> dot2;
    in property <color> dot3;
    in property <color> dot4;
    in property <color> card-bg: Theme.field-bg;
    in property <color> card-text: Theme.text;
    in property <color> card-border: Theme.field-border;
    in property <color> card-accent: Theme.accent;
    in property <color> card-hover: Theme.hover;
    callback clicked();

    width: 200px;
    height: 72px;
    border-radius: 10px;
    background: touch.has-hover ? root.card-hover : root.card-bg;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? root.card-accent : root.card-border;
    clip: true;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        alignment: center;

        HorizontalLayout {
            spacing: 6px;

            Text {
                text: root.label;
                font-size: 12px;
                font-weight: 600;
                color: root.card-text;
                horizontal-alignment: left;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            if root.checked : VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: root.card-accent;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: #ffffff;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.dot1;
                border-width: 1px;
                border-color: #00000030;
            }

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.dot2;
                border-width: 1px;
                border-color: #00000030;
            }

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.dot3;
                border-width: 1px;
                border-color: #00000030;
            }

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.dot4;
                border-width: 1px;
                border-color: #00000030;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A preset card wired to one of the themes in ThemePreference.
component PresetCard inherits ThemePresetCard {
    in property <ThemePreference> preset;
    callback chosen(ThemePreference);

    label: Theme.preset-label(root.preset);
    checked: Theme.preference == root.preset;
    dot1: Theme.dot1(root.preset);
    dot2: Theme.dot2(root.preset);
    dot3: Theme.dot3(root.preset);
    dot4: Theme.dot4(root.preset);
    card-bg: Theme.preset-bg(root.preset);
    card-text: Theme.preset-text(root.preset);
    card-border: Theme.preset-border(root.preset);
    card-accent: Theme.preset-accent(root.preset);
    card-hover: Theme.preset-field(root.preset);

    clicked => {
        Theme.preference = root.preset;
        root.chosen(root.preset);
    }
}

// One editable hex colour: label, live swatch, and a text field.
component CustomColourField inherits Rectangle {
    in property <string> label;
    in property <string> hex;
    in property <color> swatch;
    callback changed(string);

    height: 26px;

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: root.label;
            width: 170px;
            font-size: 11px;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        Rectangle {
            width: 22px;
            height: 18px;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.field-border;
            background: root.swatch;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 24px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.field-border;
            background: Theme.field-bg;

            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: center;

                TextInput {
                    text: root.hex;
                    font-size: 11px;
                    color: Theme.text;
                    edited => { root.changed(self.text); }
                }
            }
        }
    }
}

// Category item card on the main Settings page
component SettingsCategoryCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    callback clicked();

    height: 64px;
    max-width: 640px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.field-border;
    background: touch.has-hover ? Theme.hover : Theme.field-bg;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 6px;
                background: Theme.is-catppuccin ? #00000025 : #0000000c;

                HorizontalLayout {
                    alignment: center;

                    Glyph {
                        source: root.icon;
                        icon-size: 20px;
                        tint: Theme.mono-tint;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: left;
            }

            Text {
                text: root.subtitle;
                font-size: 11px;
                color: Theme.text-secondary;
                horizontal-alignment: left;
            }
        }

        Glyph {
            source: @image-url("../icons/chevron-right.svg");
            icon-size: 14px;
            tint: Theme.mono-tint;
            faded: 0.6;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsPage inherits Rectangle {
    background: Theme.bg;

    callback theme-selected(ThemePreference);
    callback custom-colors-changed();
    callback go-back();

    // "" = Settings main menu, "theme" = Theme subpage
    in-out property <string> current-subpage: "";

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Top Navigation Bar
        Rectangle {
            height: 44px;
            background: Theme.sidebar-bg;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: 6px;
                    border-radius: 4px;
                    background: back-touch.has-hover ? Theme.hover : transparent;

                    HorizontalLayout {
                        alignment: center;

                        Glyph {
                            source: @image-url("../icons/arrow-left.svg");
                            tint: Theme.mono-tint;
                            icon-size: 16px;
                        }
                    }

                    back-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            if root.current-subpage == "theme" {
                                root.current-subpage = "";
                            } else {
                                root.go-back();
                            }
                        }
                    }
                }

                Text {
                    text: root.current-subpage == "theme" ? "Theme" : "Settings";
                    font-size: 16px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                Rectangle { }
            }
        }

        // Separator below header
        Rectangle {
            height: 1px;
            background: Theme.separator;
        }

        // VIEW 1: Main Settings Menu
        if root.current-subpage == "" : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Preferences";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                }

                SettingsCategoryCard {
                    title: "Theme";
                    subtitle: "Personalize your colors and appearance presets";
                    icon: @image-url("../icons/palette.svg");
                    clicked => { root.current-subpage = "theme"; }
                }

                SettingsCategoryCard {
                    title: "About Folder Lab";
                    subtitle: "Version 0.1.0 • Built with Slint & Rust";
                    icon: @image-url("../icons/pc.svg");
                }

                Rectangle { }
            }
        }

        // VIEW 2: Theme Subpage (Presets Grid matching Image 2)
        if root.current-subpage == "theme" : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: "Presets";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                }

                // Presets wrap into as many columns as fit; centering each line
                // splits the free width into two equal left/right margins.
                FlexboxLayout {
                    spacing: 12px;
                    alignment: center;
                    cross-axis-line-alignment: start;

                    for item in Theme.presets : PresetCard {
                        preset: item;
                        chosen(value) => { root.theme-selected(value); }
                    }
                }

                Text {
                    text: "Custom colours";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                }

                Text {
                    text: "Write any #RRGGBB colour — it applies as you type.";
                    font-size: 11px;
                    color: Theme.text-secondary;
                }

                VerticalLayout {
                    spacing: 6px;
                    CustomColourField {
                        label: "Background";
                        hex: Theme.custom-bg-hex;
                        swatch: Theme.custom-bg;
                        changed(text) => {
                            Theme.custom-bg-hex = text;
                            Theme.preference = ThemePreference.custom;
                            root.custom-colors-changed();
                        }
                    }
                    CustomColourField {
                        label: "Sidebar / tabs";
                        hex: Theme.custom-sidebar-hex;
                        swatch: Theme.custom-sidebar;
                        changed(text) => {
                            Theme.custom-sidebar-hex = text;
                            Theme.preference = ThemePreference.custom;
                            root.custom-colors-changed();
                        }
                    }
                    CustomColourField {
                        label: "Ribbon";
                        hex: Theme.custom-ribbon-hex;
                        swatch: Theme.custom-ribbon;
                        changed(text) => {
                            Theme.custom-ribbon-hex = text;
                            Theme.preference = ThemePreference.custom;
                            root.custom-colors-changed();
                        }
                    }
                    CustomColourField {
                        label: "Cards and fields";
                        hex: Theme.custom-field-hex;
                        swatch: Theme.custom-field;
                        changed(text) => {
                            Theme.custom-field-hex = text;
                            Theme.preference = ThemePreference.custom;
                            root.custom-colors-changed();
                        }
                    }
                    CustomColourField {
                        label: "Accent";
                        hex: Theme.custom-accent-hex;
                        swatch: Theme.custom-accent;
                        changed(text) => {
                            Theme.custom-accent-hex = text;
                            Theme.preference = ThemePreference.custom;
                            root.custom-colors-changed();
                        }
                    }
                    CustomColourField {
                        label: "Text";
                        hex: Theme.custom-text-hex;
                        swatch: Theme.custom-text;
                        changed(text) => {
                            Theme.custom-text-hex = text;
                            Theme.preference = ThemePreference.custom;
                            root.custom-colors-changed();
                        }
                    }
                    CustomColourField {
                        label: "Secondary text";
                        hex: Theme.custom-text-secondary-hex;
                        swatch: Theme.custom-text-secondary;
                        changed(text) => {
                            Theme.custom-text-secondary-hex = text;
                            Theme.preference = ThemePreference.custom;
                            root.custom-colors-changed();
                        }
                    }
                    CustomColourField {
                        label: "Borders";
                        hex: Theme.custom-border-hex;
                        swatch: Theme.custom-border;
                        changed(text) => {
                            Theme.custom-border-hex = text;
                            Theme.preference = ThemePreference.custom;
                            root.custom-colors-changed();
                        }
                    }
                    CustomColourField {
                        label: "Icon tint";
                        hex: Theme.custom-icon-tint-hex;
                        swatch: Theme.custom-icon-tint;
                        changed(text) => {
                            Theme.custom-icon-tint-hex = text;
                            Theme.preference = ThemePreference.custom;
                            root.custom-colors-changed();
                        }
                    }
                }
                Rectangle { }
            }
        }
    }
}
