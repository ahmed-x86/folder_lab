import { Theme, ThemePreference } from "../theme.slint";
import { Glyph } from "../components/glyph.slint";

// Preset card inspired by modern theme pickers (Title + 4 palette color dots)
component ThemePresetCard inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <color> dot1;
    in property <color> dot2;
    in property <color> dot3;
    in property <color> dot4;
    callback clicked();

    width: 200px;
    height: 72px;
    border-radius: 10px;
    background: touch.has-hover ? Theme.hover : Theme.field-bg;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? Theme.accent : Theme.field-border;
    clip: true;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        alignment: center;

        HorizontalLayout {
            spacing: 6px;

            Text {
                text: root.label;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: left;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            if root.checked : VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: Theme.accent;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: #ffffff;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.dot1;
                border-width: 1px;
                border-color: #00000030;
            }

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.dot2;
                border-width: 1px;
                border-color: #00000030;
            }

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.dot3;
                border-width: 1px;
                border-color: #00000030;
            }

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.dot4;
                border-width: 1px;
                border-color: #00000030;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Category item card on the main Settings page
component SettingsCategoryCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    callback clicked();

    height: 64px;
    max-width: 640px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.field-border;
    background: touch.has-hover ? Theme.hover : Theme.field-bg;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 6px;
                background: Theme.is-catppuccin ? #00000025 : #0000000c;

                Glyph {
                    source: root.icon;
                    icon-size: 20px;
                    tint: Theme.mono-tint;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: left;
            }

            Text {
                text: root.subtitle;
                font-size: 11px;
                color: Theme.text-secondary;
                horizontal-alignment: left;
            }
        }

        Glyph {
            source: @image-url("../icons/chevron-right.svg");
            icon-size: 14px;
            tint: Theme.mono-tint;
            faded: 0.6;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsPage inherits Rectangle {
    background: Theme.bg;

    callback theme-selected(ThemePreference);
    callback go-back();

    // "" = Settings main menu, "theme" = Theme subpage
    in-out property <string> current-subpage: "";

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Top Navigation Bar
        Rectangle {
            height: 44px;
            background: Theme.sidebar-bg;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: 6px;
                    border-radius: 4px;
                    background: back-touch.has-hover ? Theme.hover : transparent;

                    Glyph {
                        source: @image-url("../icons/arrow-left.svg");
                        tint: Theme.mono-tint;
                        icon-size: 16px;
                    }

                    back-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            if root.current-subpage == "theme" {
                                root.current-subpage = "";
                            } else {
                                root.go-back();
                            }
                        }
                    }
                }

                Text {
                    text: root.current-subpage == "theme" ? "Theme" : "Settings";
                    font-size: 16px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                Rectangle { }
            }
        }

        // Separator below header
        Rectangle {
            height: 1px;
            background: Theme.separator;
        }

        // VIEW 1: Main Settings Menu
        if root.current-subpage == "" : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Preferences";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                }

                SettingsCategoryCard {
                    title: "Theme";
                    subtitle: "Personalize your colors and appearance presets";
                    icon: @image-url("../icons/palette.svg");
                    clicked => { root.current-subpage = "theme"; }
                }

                SettingsCategoryCard {
                    title: "About Folder Lab";
                    subtitle: "Version 0.1.0 • Built with Slint & Rust";
                    icon: @image-url("../icons/pc.svg");
                }

                Rectangle { }
            }
        }

        // VIEW 2: Theme Subpage (Presets Grid matching Image 2)
        if root.current-subpage == "theme" : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: "Presets";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                }

                // Row 1: Follow system, Light, Dark
                HorizontalLayout {
                    spacing: 12px;

                    ThemePresetCard {
                        label: "Follow system";
                        checked: Theme.preference == ThemePreference.system;
                        dot1: #3b9eef;
                        dot2: #2b2b2b;
                        dot3: #ffffff;
                        dot4: #8f8f8f;
                        clicked => {
                            Theme.preference = ThemePreference.system;
                            root.theme-selected(ThemePreference.system);
                        }
                    }

                    ThemePresetCard {
                        label: "Light";
                        checked: Theme.preference == ThemePreference.light;
                        dot1: #0078d7;
                        dot2: #ffffff;
                        dot3: #f2f2f2;
                        dot4: #1f1f1f;
                        clicked => {
                            Theme.preference = ThemePreference.light;
                            root.theme-selected(ThemePreference.light);
                        }
                    }

                    ThemePresetCard {
                        label: "Dark";
                        checked: Theme.preference == ThemePreference.dark;
                        dot1: #3b9eef;
                        dot2: #1f1f1f;
                        dot3: #2b2b2b;
                        dot4: #e6e6e6;
                        clicked => {
                            Theme.preference = ThemePreference.dark;
                            root.theme-selected(ThemePreference.dark);
                        }
                    }

                    Rectangle { }
                }

                // Row 2: Catppuccin Latte, Frappé, Macchiato
                HorizontalLayout {
                    spacing: 12px;

                    ThemePresetCard {
                        label: "Catppuccin Latte";
                        checked: Theme.preference == ThemePreference.latte;
                        dot1: #8839ef;
                        dot2: #1e66f5;
                        dot3: #eff1f5;
                        dot4: #4c4f69;
                        clicked => {
                            Theme.preference = ThemePreference.latte;
                            root.theme-selected(ThemePreference.latte);
                        }
                    }

                    ThemePresetCard {
                        label: "Catppuccin Frappé";
                        checked: Theme.preference == ThemePreference.frappe;
                        dot1: #ca9ee6;
                        dot2: #8caaee;
                        dot3: #303446;
                        dot4: #c6d0f5;
                        clicked => {
                            Theme.preference = ThemePreference.frappe;
                            root.theme-selected(ThemePreference.frappe);
                        }
                    }

                    ThemePresetCard {
                        label: "Catppuccin Macchiato";
                        checked: Theme.preference == ThemePreference.macchiato;
                        dot1: #c6a0f6;
                        dot2: #8aadf4;
                        dot3: #24273a;
                        dot4: #cad3f5;
                        clicked => {
                            Theme.preference = ThemePreference.macchiato;
                            root.theme-selected(ThemePreference.macchiato);
                        }
                    }

                    Rectangle { }
                }

                // Row 3: Catppuccin Mocha
                HorizontalLayout {
                    spacing: 12px;

                    ThemePresetCard {
                        label: "Catppuccin Mocha";
                        checked: Theme.preference == ThemePreference.mocha;
                        dot1: #cba6f7;
                        dot2: #89b4fa;
                        dot3: #1e1e2e;
                        dot4: #cdd6f4;
                        clicked => {
                            Theme.preference = ThemePreference.mocha;
                            root.theme-selected(ThemePreference.mocha);
                        }
                    }

                    Rectangle { }
                }

                Rectangle { }
            }
        }
    }
}
