import { Theme } from "../theme.slint";
import { Glyph } from "../components/glyph.slint";
import { DriveCard } from "../components/drive-card.slint";
import { FileCard } from "../components/file-card.slint";
import { DetailsHeaderCell } from "../components/details-header-cell.slint";
import { DetailsRow } from "../components/details-row.slint";
import { ScrollArea } from "../components/scroll-area.slint";
import { DiskInfo, FileEntry, BrowseState, ViewMode, SortField, SortOrder } from "../types.slint";
import { ViewModeUtils } from "../view-mode-utils.slint";

export component ContentPane inherits Rectangle {
    in property <[DiskInfo]> disks;
    in property <[FileEntry]> files;
    in property <BrowseState> browse-state: BrowseState.Home;
    in-out property <ViewMode> view-mode: ViewMode.MediumIcons;
    in-out property <SortField> sort-field: SortField.Name;
    in-out property <SortOrder> sort-order: SortOrder.Ascending;
    in-out property <int> selected-index: -1;

    callback navigate-to(string);
    callback key-nav(string);
    callback navigate-arrows(int);
    callback activate-selected();
    callback sort-requested(SortField);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback refresh();
    callback toggle-hidden();
    callback new-folder();
    callback delete();
    callback copy();
    callback cut();
    callback paste();
    callback toggle-details();
    callback view-mode-changed(ViewMode);

    horizontal-stretch: 1;
    background: Theme.bg;

    // ── حسابات الشبكة، تتغيّر حسب وضع العرض الحالي ──────────────────────
    property <bool> is-grid: ViewModeUtils.is-grid-layout(root.view-mode);
    property <length> item-width: ViewModeUtils.cell-width(root.view-mode);
    property <length> item-height: ViewModeUtils.cell-height(root.view-mode);
    property <length> icon-px: ViewModeUtils.icon-size(root.view-mode);
    property <length> row-h: ViewModeUtils.row-height(root.view-mode);
    property <length> item-spacing: 8px;
    property <length> scrollbar-reserve: 14px;

    // Available width for the grid items
    property <length> avail-w: max(100px, root.width - root.scrollbar-reserve);

    // Number of full columns that fit in avail-w (only meaningful in grid modes)
    property <int> cols: max(1, floor((root.avail-w - 28px + root.item-spacing) / (root.item-width + root.item-spacing)));

    // Total width occupied by all columns
    property <length> grid-w: root.cols * root.item-width + (root.cols - 1) * root.item-spacing;

    // Symmetrical left and right padding so right margin equals left margin
    property <length> h-pad: max(14px, floor((root.avail-w - root.grid-w) / 2px) * 1px);

    // Number of rows needed, used to give ScrollArea an explicit
    // content-height (see scroll-area.slint for why this must be explicit
    // rather than auto-measured from the `for` loop's children).
    property <int> item-count: root.browse-state == BrowseState.Home ? root.disks.length : root.files.length;
    property <int> row-count: root.is-grid
        ? ceil(root.item-count / root.cols)
        : root.item-count;
    // Details has the 28px column header plus a 1px separator and a 4px gap
    // above the rows, so its rows start lower and need more total height than
    // List/Content. Using one shared 40px offset left the last rows
    // unreachable behind the bottom edge of the viewport.
    property <length> list-top: root.view-mode == ViewMode.Details ? 42px : 14px;
    property <length> content-h: root.is-grid
        ? 27px + root.row-count * (root.item-height + root.item-spacing)
        : root.list-top + 14px + root.row-count * (root.row-h + 1px);

    // Selected item position for auto-scroll
    property <int> sel-row: root.selected-index >= 0 ? (root.is-grid ? floor(root.selected-index / root.cols) : root.selected-index) : -1;
    property <length> sel-y: root.sel-row >= 0 ? (root.is-grid ? 14px + root.sel-row * (root.item-height + root.item-spacing) : root.list-top + root.sel-row * (root.row-h + 1px)) : 0px;
    property <length> item-visible-h: root.is-grid ? root.item-height : root.row-h;

    public function focus-pane() {
        fs.focus();
    }

    function ensure-visible() {
        if (root.sel-row >= 0) {
            if (root.sel-y < -scroll.content-y) {
                scroll.content-y = min(0px, -root.sel-y + 14px);
            } else if (root.sel-y + root.item-visible-h > -scroll.content-y + scroll.visible-height) {
                scroll.content-y = min(0px, -(root.sel-y + root.item-visible-h - scroll.visible-height + 14px));
            }
        }
    }

    changed selected-index => {
        root.ensure-visible();
    }

    // عند تغيّر وضع العرض (من قائمة View أو من Ctrl+Wheel) يتغيّر معنى
    // "صف واحد" (قد يصبح عدد الأعمدة مختلفًا)، فنعيد ضبط التمرير لأعلى
    // كي لا يبقى المستخدم في موضع تمرير عشوائي بالنسبة للتخطيط الجديد.
    changed view-mode => {
        scroll.content-y = 0px;
        scroll.content-x = 0px;
    }

    public function zoom-in() {
        root.view-mode = ViewModeUtils.zoom-in(root.view-mode);
        root.view-mode-changed(root.view-mode);
    }

    public function zoom-out() {
        root.view-mode = ViewModeUtils.zoom-out(root.view-mode);
        root.view-mode-changed(root.view-mode);
    }

    forward-focus: fs;

    fs := FocusScope {
        width: 100%;
        height: 100%;

        init => {
            fs.focus();
        }

        key-pressed(ev) => {
            // Shortcuts with Alt
            if (ev.modifiers.alt) {
                if (ev.text == Key.LeftArrow) {
                    root.go-back();
                    return accept;
                }
                if (ev.text == Key.RightArrow) {
                    root.go-forward();
                    return accept;
                }
                if (ev.text == Key.UpArrow) {
                    root.go-up();
                    return accept;
                }
                if (ev.text == "p" || ev.text == "P") {
                    root.toggle-details();
                    return accept;
                }
            }

            // Shortcuts with Control
            if (ev.modifiers.control) {
                if (ev.modifiers.shift && (ev.text == "n" || ev.text == "N")) {
                    root.new-folder();
                    return accept;
                }
                if (ev.text == "h" || ev.text == "H") {
                    root.toggle-hidden();
                    return accept;
                }
                if (ev.text == "r" || ev.text == "R") {
                    root.refresh();
                    return accept;
                }
                if (ev.text == "c" || ev.text == "C") {
                    root.copy();
                    return accept;
                }
                if (ev.text == "x" || ev.text == "X") {
                    root.cut();
                    return accept;
                }
                if (ev.text == "v" || ev.text == "V") {
                    root.paste();
                    return accept;
                }
                // Ctrl+Plus / Ctrl+Minus step through view modes, matching
                // the Ctrl+Wheel behaviour for people without a mouse wheel.
                if (ev.text == "+" || ev.text == "=") {
                    root.zoom-in();
                    return accept;
                }
                if (ev.text == "-" || ev.text == "_") {
                    root.zoom-out();
                    return accept;
                }
                if (ev.text == "1") {
                    root.view-mode = ViewMode.LargeIcons;
                    root.view-mode-changed(root.view-mode);
                    return accept;
                }
                if (ev.text == "2") {
                    root.view-mode = ViewMode.Details;
                    root.view-mode-changed(root.view-mode);
                    return accept;
                }
                if (ev.text == "d" || ev.text == "D") {
                    root.toggle-details();
                    return accept;
                }
            }

            // Function & Navigation keys
            if (ev.text == Key.F5) {
                root.refresh();
                return accept;
            }
            if (ev.text == Key.Delete) {
                root.delete();
                return accept;
            }
            if (ev.text == Key.Backspace) {
                root.go-back();
                return accept;
            }
            if (ev.text == Key.Escape) {
                root.selected-index = -1;
                return accept;
            }
            if (ev.text == Key.Return) {
                root.activate-selected();
                return accept;
            }
            if (ev.text == Key.UpArrow) {
                root.navigate-arrows(root.browse-state == BrowseState.Home ? -1 : (root.is-grid ? -root.cols : -1));
                return accept;
            }
            if (ev.text == Key.DownArrow) {
                root.navigate-arrows(root.browse-state == BrowseState.Home ? 1 : (root.is-grid ? root.cols : 1));
                return accept;
            }
            if (ev.text == Key.LeftArrow) {
                root.navigate-arrows(-1);
                return accept;
            }
            if (ev.text == Key.RightArrow) {
                root.navigate-arrows(1);
                return accept;
            }

            // Fast letter search
            if (ev.text != "" && !ev.modifiers.control && !ev.modifiers.alt) {
                root.key-nav(ev.text);
                return accept;
            }
            reject
        }

        scroll := ScrollArea {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            content-width: root.width;
            content-height: root.content-h;

            // ── HOME: show drive cards ───────────────────────────────────────
            if root.browse-state == BrowseState.Home : VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 6px;

                    Glyph {
                        source: @image-url("../icons/chevron-down.svg");
                        tint: Theme.mono-tint;
                        icon-size: 10px;
                        faded: 0.65;
                    }

                    Text {
                        text: "Devices and drives";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }

                FlexboxLayout {
                    spacing: 8px;

                    for disk[i] in root.disks : DriveCard {
                        disk: disk;
                        selected: root.selected-index == i;
                        clicked => {
                            root.selected-index = i;
                            fs.focus();
                        }
                        double-clicked => {
                            root.navigate-to(disk.mount);
                        }
                    }
                }

                if root.disks.length == 0 : Text {
                    text: "No mounted partitions were found.";
                    font-size: 12px;
                    color: Theme.text-muted;
                }

                Rectangle { }
            }

            // ── DIRECTORY: grid-like views (Extra large / Large / Medium / Small icons / Tiles) ──
            // الـTouchArea الأب هنا لا يلتقط نقرات البطاقات (الأبناء يُستقبلون
            // أولًا)، لكنه يعيد سلوك النقر على المساحة الفارغة لإلغاء التحديد.
            if root.browse-state == BrowseState.Directory && root.is-grid : TouchArea {
                clicked => {
                    root.selected-index = -1;
                    fs.focus();
                }

                FlexboxLayout {
                    alignment: LayoutAlignment.start;
                    cross-axis-line-alignment: LayoutAlignment.start;
                    cross-axis-alignment: CrossAxisAlignment.start;
                    spacing: root.item-spacing;
                    padding-left: root.h-pad;
                    padding-right: root.h-pad;
                    padding-top: 14px;
                    padding-bottom: 14px;

                    for entry[i] in root.files : FileCard {
                        entry: entry;
                        selected: root.selected-index == i;
                        card-width: root.item-width;
                        card-height: root.item-height;
                        icon-size: root.icon-px;
                        label-beside-icon: root.view-mode == ViewMode.SmallIcons || root.view-mode == ViewMode.Tiles;
                        clicked => {
                            root.selected-index = i;
                            fs.focus();
                        }
                        double-clicked => {
                            if (entry.is-dir) {
                                root.navigate-to(entry.name);
                            }
                        }
                        zoom-requested(dir) => {
                            if (dir > 0) {
                                root.zoom-in();
                            } else {
                                root.zoom-out();
                            }
                        }
                    }
                }
            }

            // ── DIRECTORY: Details view (full column header + rows) ──────────
            if root.browse-state == BrowseState.Directory && root.view-mode == ViewMode.Details : VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 8px;
                padding-bottom: 14px;
                spacing: 1px;

                    // Header row
                    HorizontalLayout {
                        height: 28px;
                        spacing: 12px;
                        alignment: start;

                        DetailsHeaderCell {
                            title: "Name";
                            col-width: 260px;
                            active: root.sort-field == SortField.Name;
                            order: root.sort-order;
                            clicked => { root.sort-requested(SortField.Name); }
                        }

                        DetailsHeaderCell {
                            title: "Date modified";
                            col-width: 140px;
                            active: root.sort-field == SortField.Date;
                            order: root.sort-order;
                            clicked => { root.sort-requested(SortField.Date); }
                        }

                        DetailsHeaderCell {
                            title: "Type";
                            col-width: 140px;
                            active: root.sort-field == SortField.Type;
                            order: root.sort-order;
                            clicked => { root.sort-requested(SortField.Type); }
                        }

                        DetailsHeaderCell {
                            title: "Size";
                            col-width: 80px;
                            active: root.sort-field == SortField.Size;
                            order: root.sort-order;
                            clicked => { root.sort-requested(SortField.Size); }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.separator;
                    }

                Rectangle { height: 4px; }

                // Items rows
                for entry[i] in root.files : DetailsRow {
                    entry: entry;
                    mode: ViewMode.Details;
                    row-height: root.row-h;
                    selected: root.selected-index == i;
                    clicked => {
                        root.selected-index = i;
                        fs.focus();
                    }
                    double-clicked => {
                        if (entry.is-dir) {
                            root.navigate-to(entry.name);
                        }
                    }
                }
            }

            // ── DIRECTORY: List / Content views (no header, name-focused rows) ──
            if root.browse-state == BrowseState.Directory
                && (root.view-mode == ViewMode.List || root.view-mode == ViewMode.Content) : VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 1px;

                for entry[i] in root.files : DetailsRow {
                    entry: entry;
                    mode: root.view-mode;
                    row-height: root.row-h;
                    selected: root.selected-index == i;
                    clicked => {
                        root.selected-index = i;
                        fs.focus();
                    }
                    double-clicked => {
                        if (entry.is-dir) {
                            root.navigate-to(entry.name);
                        }
                    }
                }
            }

            // ── NO PERMISSION ────────────────────────────────────────────────
            if root.browse-state == BrowseState.NoPermission : Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-height: 300px;

                VerticalLayout {
                    alignment: center;
                    spacing: 10px;

                    Text {
                        text: "You do not have permission to view the contents of this folder.";
                        font-size: 13px;
                        color: Theme.text-muted;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                }
            }

            // ── EMPTY ────────────────────────────────────────────────────────
            if root.browse-state == BrowseState.Empty : Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-height: 300px;

                VerticalLayout {
                    alignment: center;
                    spacing: 10px;

                    Text {
                        text: "This folder is empty.";
                        font-size: 13px;
                        color: Theme.text-muted;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                }
            }
        }
    }
}
