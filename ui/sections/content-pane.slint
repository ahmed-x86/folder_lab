import { Theme } from "../theme.slint";
import { Glyph } from "../components/glyph.slint";
import { DriveCard } from "../components/drive-card.slint";
import { FileCard } from "../components/file-card.slint";
import { DiskInfo, FileEntry, BrowseState } from "../types.slint";
import { ScrollView } from "std-widgets.slint";

export component ContentPane inherits Rectangle {
    in property <[DiskInfo]> disks;
    in property <[FileEntry]> files;
    in property <BrowseState> browse-state: BrowseState.Home;
    in-out property <int> selected-index: -1;

    callback navigate-to(string);
    callback key-nav(string);
    callback navigate-arrows(int);
    callback activate-selected();

    horizontal-stretch: 1;
    background: Theme.bg;

    // Grid sizing and symmetrical centering math
    property <length> item-width: 96px;
    property <length> item-height: 94px;
    property <length> item-spacing: 8px;
    property <length> scrollbar-reserve: 14px;

    // Available width for the grid items
    property <length> avail-w: max(100px, root.width - root.scrollbar-reserve);

    // Number of full columns that fit in avail-w
    property <int> cols: max(1, floor((root.avail-w - 28px + root.item-spacing) / (root.item-width + root.item-spacing)));

    // Total width occupied by all columns
    property <length> grid-w: root.cols * root.item-width + (root.cols - 1) * root.item-spacing;

    // Symmetrical left and right padding so right margin equals left margin
    property <length> h-pad: max(14px, floor((root.avail-w - root.grid-w) / 2px) * 1px);

    // Selected item position for auto-scroll
    property <int> sel-row: root.selected-index >= 0 ? floor(root.selected-index / root.cols) : -1;
    property <length> sel-y: root.sel-row >= 0 ? 14px + root.sel-row * (root.item-height + root.item-spacing) : 0px;

    public function focus-pane() {
        fs.focus();
    }

    function ensure-visible() {
        if (root.sel-row >= 0) {
            if (root.sel-y < -scroll.content-y) {
                scroll.content-y = min(0px, -root.sel-y + 14px);
            } else if (root.sel-y + root.item-height > -scroll.content-y + scroll.visible-height) {
                scroll.content-y = min(0px, -(root.sel-y + root.item-height - scroll.visible-height + 14px));
            }
        }
    }

    changed selected-index => {
        root.ensure-visible();
    }

    forward-focus: fs;

    fs := FocusScope {
        width: 100%;
        height: 100%;

        init => {
            fs.focus();
        }

        key-pressed(ev) => {
            if (ev.text == Key.Return) {
                root.activate-selected();
                return accept;
            }
            if (ev.text == Key.UpArrow) {
                root.navigate-arrows(-root.cols);
                return accept;
            }
            if (ev.text == Key.DownArrow) {
                root.navigate-arrows(root.cols);
                return accept;
            }
            if (ev.text == Key.LeftArrow) {
                root.navigate-arrows(-1);
                return accept;
            }
            if (ev.text == Key.RightArrow) {
                root.navigate-arrows(1);
                return accept;
            }
            if (ev.text != "") {
                root.key-nav(ev.text);
                return accept;
            }
            reject
        }

        scroll := ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            // ── HOME: show drive cards ───────────────────────────────────────
            if root.browse-state == BrowseState.Home : VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 6px;

                    Glyph {
                        source: @image-url("../icons/chevron-down.svg");
                        tint: Theme.mono-tint;
                        icon-size: 10px;
                        faded: 0.65;
                    }

                    Text {
                        text: "Devices and drives";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }

                FlexboxLayout {
                    spacing: 8px;

                    for disk[i] in root.disks : DriveCard {
                        disk: disk;
                        double-clicked => {
                            root.navigate-to(disk.mount);
                        }
                    }
                }

                if root.disks.length == 0 : Text {
                    text: "No mounted partitions were found.";
                    font-size: 12px;
                    color: Theme.text-muted;
                }

                Rectangle { }
            }

            // ── DIRECTORY: show files and folders with centered margins ───────
            if root.browse-state == BrowseState.Directory : TouchArea {
                clicked => {
                    root.selected-index = -1;
                    fs.focus();
                }

                FlexboxLayout {
                    alignment: LayoutAlignment.start;
                    cross-axis-line-alignment: LayoutAlignment.start;
                    cross-axis-alignment: CrossAxisAlignment.start;
                    spacing: root.item-spacing;
                    padding-left: root.h-pad;
                    padding-right: root.h-pad;
                    padding-top: 14px;
                    padding-bottom: 14px;

                    for entry[i] in root.files : FileCard {
                        entry: entry;
                        selected: root.selected-index == i;
                        clicked => {
                            root.selected-index = i;
                            fs.focus();
                        }
                        double-clicked => {
                            if (entry.is-dir) {
                                root.navigate-to(entry.name);
                            }
                        }
                    }
                }
            }

            // ── NO PERMISSION ────────────────────────────────────────────────
            if root.browse-state == BrowseState.NoPermission : Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-height: 300px;

                VerticalLayout {
                    alignment: center;
                    spacing: 10px;

                    Text {
                        text: "You do not have permission to view the contents of this folder.";
                        font-size: 13px;
                        color: Theme.text-muted;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                }
            }

            // ── EMPTY ────────────────────────────────────────────────────────
            if root.browse-state == BrowseState.Empty : Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-height: 300px;

                VerticalLayout {
                    alignment: center;
                    spacing: 10px;

                    Text {
                        text: "This folder is empty.";
                        font-size: 13px;
                        color: Theme.text-muted;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        vertical-alignment: TextVerticalAlignment.center;
                    }
                }
            }
        }
    }
}
